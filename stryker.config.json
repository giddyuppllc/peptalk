{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "_comment": "Mutation testing scoped to modules where a silent mutation causes real harm: wrong tier or a bad charge (entitlement/products/square), a mis-dosed injection (doseSafety), an unauthenticated user walking into the app (routeGuard), or a silently dead video (streamUrl). All are pure and unit-tested.",
  "packageManager": "pnpm",
  "testRunner": "jest",
  "jest": {
    "projectType": "custom",
    "configFile": "jest.config.js"
  },
  "reporters": [
    "clear-text",
    "progress"
  ],
  "coverageAnalysis": "off",
  "concurrency": 2,
  "ignorePatterns": [
    "ios",
    "android",
    "dist",
    "public",
    ".expo",
    ".vercel",
    ".vercel-link",
    "assets",
    "docs",
    "scripts",
    "_elevate_audit",
    "reports",
    "*.png"
  ],
  "mutate": [
    "src/lib/entitlement.ts",
    "src/lib/products.ts",
    "supabase/functions/_shared/square.ts",
    "src/services/doseSafety.ts",
    "src/lib/routeGuard.ts",
    "src/utils/streamUrl.ts"
  ]
}
