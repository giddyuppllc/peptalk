{
  "name": "peptalk",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:mutation": "stryker run",
    "verify:calc": "tsx scripts/verify-calculator-math.ts",
    "verify:sanitize": "tsx scripts/verify-aimee-action-sanitize.ts",
    "verify:cycle": "tsx scripts/verify-cycle-predictor.ts",
    "verify:adherence": "tsx scripts/verify-dose-adherence.ts",
    "verify:labparsers": "tsx scripts/verify-lab-parsers.ts",
    "verify:mealmath": "tsx scripts/verify-meal-math.ts",
    "verify:dosecalc": "tsx scripts/verify-dose-calculator.ts",
    "verify:inbody": "tsx scripts/verify-inbody-parser.ts",
    "verify:csp": "tsx scripts/verify-csp.ts",
    "verify:aimee": "tsx scripts/verify-aimee.ts",
    "build-gap": "tsx scripts/build-gap.ts",
    "backlog:dosing": "tsx scripts/gen-dosing-backlog.ts > DOSING_DATA_BACKLOG.md",
    "verify:build": "tsx scripts/verify-build.ts",
    "verify:all": "npm run verify:data && npm run verify:functions && npm run verify:square && npm run verify:csp && npm run verify:aimee && npm run verify:routes && npm run verify:videos && npm run verify:calc && npm run verify:sanitize && npm run verify:cycle && npm run verify:adherence && npm run verify:labparsers && npm run verify:mealmath && npm run verify:dosecalc && npm run verify:inbody && npm run verify:deadzones && npm run verify:peptiderefs && npm run verify:navparams && npm run verify:aimeescreens && npm run verify:synccolumns && npm run verify:deadcomponents && npm run verify:deadfiles && npm run verify:dosingconsistency && npm run verify:doseprovenance && npm run verify:doseformat && npm run verify:scannercontrols && npm run verify:skips",
    "verify:deploy": "bash scripts/verify-deploy.sh",
    "lint": "expo lint",
    "export:web": "expo export --platform web && node scripts/inject-pwa.mjs",
    "deploy:web": "npm run export:web && npm run verify:build && node scripts/deploy-web.mjs",
    "verify:data": "tsx scripts/validatePeptideData.ts",
    "verify:functions": "tsx scripts/verify-edge-functions.ts",
    "verify:square": "tsx scripts/verify-square-catalog.ts",
    "verify:routes": "tsx scripts/verify-route-reachability.ts",
    "verify:videos": "tsx scripts/verify-video-integrity.ts",
    "lint:ci": "eslint app src --max-warnings 0",
    "verify:deadzones": "node scripts/verify-deadzones.mjs",
    "verify:peptiderefs": "tsx scripts/verify-peptide-refs.ts",
    "verify:navparams": "node scripts/verify-nav-params.mjs",
    "verify:deadcomponents": "node scripts/verify-dead-components.mjs",
    "verify:deadfiles": "node scripts/verify-dead-files.mjs",
    "verify:dosingconsistency": "node scripts/verify-dosing-consistency.mjs",
    "verify:doseprovenance": "node scripts/verify-dose-provenance.mjs",
    "verify:doseformat": "node scripts/verify-dose-format.mjs",
    "verify:scannercontrols": "node scripts/verify-scanner-controls.mjs",
    "export:review": "tsx scripts/export-clinical-review.ts",
    "verify:vacuous": "node scripts/verify-scanner-mutation.mjs",
    "verify:aimeescreens": "node scripts/verify-aimee-screens.mjs",
    "verify:synccolumns": "node scripts/verify-sync-columns.mjs",
    "verify:skips": "node scripts/verify-skips.mjs",
    "apply:review": "tsx scripts/apply-clinical-review.ts"
  },
  "expo": {
    "install": {
      "exclude": [
        "@sentry/react-native"
      ]
    },
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "react-native-iap",
          "react-native-health",
          "react-native-encrypted-storage"
        ],
        "listUnknownPackages": false
      }
    }
  },
  "pnpm": {
    "overrides": {
      "@expo/fingerprint": "0.15.4"
    }
  },
  "dependencies": {
    "@expo-google-fonts/dm-sans": "^0.4.2",
    "@expo-google-fonts/newsreader": "^0.4.1",
    "@expo-google-fonts/playfair-display": "^0.4.2",
    "@expo/ngrok": "~4.1.3",
    "@expo/vector-icons": "~15.0.3",
    "@gluestack-style/react": "^1.0.57",
    "@gluestack-ui/themed": "^1.1.73",
    "@react-native-async-storage/async-storage": "~2.2.0",
    "@react-native-community/netinfo": "11.4.1",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/native": "^7.1.8",
    "@react-navigation/native-stack": "^7.3.16",
    "@sentry/react-native": "~8.11.1",
    "@supabase/supabase-js": "~2.102.1",
    "expo": "~54.0.36",
    "expo-av": "~16.0.8",
    "expo-blur": "~15.0.8",
    "expo-build-properties": "~1.0.10",
    "expo-camera": "~17.0.10",
    "expo-clipboard": "~8.0.8",
    "expo-constants": "~18.0.13",
    "expo-device": "~8.0.10",
    "expo-file-system": "~19.0.21",
    "expo-font": "~14.0.11",
    "expo-haptics": "~15.0.8",
    "expo-image": "~3.0.11",
    "expo-image-picker": "~17.0.11",
    "expo-linear-gradient": "~15.0.8",
    "expo-linking": "~8.0.12",
    "expo-notifications": "~0.32.17",
    "expo-print": "~15.0.8",
    "expo-router": "~6.0.23",
    "expo-secure-store": "~15.0.8",
    "expo-sharing": "~14.0.8",
    "expo-speech": "~14.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-store-review": "~9.0.9",
    "nativewind": "^4.2.3",
    "openai": "~6.22.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-encrypted-storage": "~4.0.3",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-health": "~1.19.0",
    "react-native-health-connect": "~3.5.0",
    "react-native-iap": "~15.2.0",
    "react-native-nitro-modules": "~0.35.4",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "~0.21.2",
    "react-native-worklets": "0.5.1",
    "tailwindcss": "3.4.17",
    "zustand": "~5.0.11"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "~3.1045.0",
    "@aws-sdk/s3-request-presigner": "~3.1045.0",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/jest-runner": "^9.6.1",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.1.0",
    "babel-plugin-transform-import-meta": "^3.0.0",
    "dotenv": "~17.4.1",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~10.0.0",
    "jest": "~29.7.0",
    "jest-expo": "~54.0.17",
    "tsx": "~4.21.0",
    "typescript": "~5.9.2"
  },
  "private": true,
  "packageManager": "pnpm@10.24.0",
  "engines": {
    "node": ">=20 <23",
    "pnpm": ">=10"
  }
}
